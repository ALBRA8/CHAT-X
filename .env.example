# Base de datos (SQLite; migrable a Postgres cambiando el provider en prisma/schema.prisma)
DATABASE_URL="file:./db/custom.db"

# Proveedor generativo: simulador (desarrollo) | comfyui-local | runpod | runninghub
ESTUDIO_PROVIDER=simulador

# ── Solo si ESTUDIO_PROVIDER apunta a un proveedor real ──
# ComfyUI local (API en tu máquina):
# COMFYUI_URL=http://127.0.0.1:8188
# RunPod:
# RUNPOD_API_KEY=
# RUNPOD_ENDPOINT_ID=
# RunningHub:
# RUNNINGHUB_API_KEY=
# RUNNINGHUB_WORKFLOW_ID=

# ── Cerebro LLM del chat GFE (P1.1 upgrade; OpenAI-compatible, sonda real) ──
# Sin LLM_API_KEY el chat responde con plantillas del genoma (meta.modo=plantilla_genoma,
# declarado). Con key, la sonda /api/sistema → llm prueba {base}/models y declara el
# estado real: OPERATIVO | NO_CONFIGURADO | ERROR (p.ej. bloqueo regional del egreso).
# LLM_API_KEY=gsk_xxx            # Groq (defecto) u otro proveedor OpenAI-compatible
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_PROVEEDOR=groq
# Ejemplo NVIDIA NIM (verificado alcanzable; GLM es modelo de RAZONAMIENTO → necesita
# LLM_MAX_TOKENS>=1024 o devuelve content=null):
# LLM_API_KEY=nvapi_xxx
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=z-ai/glm-5.3-flash
# LLM_PROVEEDOR=nvidia
# LLM_MAX_TOKENS=1024

# ── Motores del ecosistema (opcional: se pueden configurar desde la UI y quedan en BD) ──
# YOUTUBE-AUTOMATION_URL=http://127.0.0.1:8000
# CRM_ALBRA_URL=http://127.0.0.1:3000
# WHATSPOWER_URL=http://127.0.0.1:3003
# WHATSPOWER_ULTRA_URL=http://127.0.0.1:3004
# NEXSCOPE_URL=http://127.0.0.1:81
